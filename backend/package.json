{
  "name": "anyblog-backend",
  "version": "1.0.0",
  "description": "anyBlog backend — Express 5 + Drizzle + Postgres + Nodemailer",
  "type": "module",
  "main": "src/server.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon --watch server.ts --watch src --ext ts --ignore node_modules --exec \"tsx server.ts\"",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "test:mail": "tsx tests/test-mail.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.23.1",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.7",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
